#!/usr/bin/env bash
# Builds the binary when the Rust sources changed, then runs it with this directory as SCOUT_HOME.
set -euo pipefail
home="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export CARGO_TARGET_DIR="$home/target"
binary="$CARGO_TARGET_DIR/release/scout"
if [[ ! -x "$binary" || -n "$(find "$home/src" "$home/Cargo.toml" -newer "$binary" -print -quit)" ]]; then
  cargo build --release --quiet --manifest-path "$home/Cargo.toml" >&2
fi
SCOUT_HOME="$home" exec "$binary" "$@"
